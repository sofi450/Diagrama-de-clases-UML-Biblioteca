package Biblioteca;

public class App {

	public static void main(String[] args) {
		// Se crea un objeto de la clase Biblioteca
		Biblioteca miBiblioteca = new Biblioteca();

		// Crear dos objetos de la clase Libro
		Libro libro1 = new Libro("Noches blancas", "Fiódor Dostoyevski", "123-4357462771");
		Libro libro2 = new Libro("La metamorfosis", "Franz Kafka", "123-3214567890");

		// Agregar los libros a la biblioteca
		miBiblioteca.agregarLibro(libro1);
		miBiblioteca.agregarLibro(libro2);

		System.out.println("Libros disponibles");
		miBiblioteca.mostrarLibros();

		// Crear dos objetos de la clase Estudiante
		Estudiante estudiante1 = new Estudiante("Sofia Diaz");
		Estudiante estudiante2 = new Estudiante("Angelica Garzon");

		// Buscar libro y realizar prestamo a Sofia
		Libro libroEncontrado1 = miBiblioteca.buscarLibro("9123-4357462771");

		if (libroEncontrado1 == null)
			System.out.println("Error: Libro no encontrado");
		else {
			Prestamo prestamo1 = new Prestamo(1, estudiante1, libroEncontrado1);
			miBiblioteca.realizarPrestamo(prestamo1);
		}

		// Buscar libro y realizar prestamo a Angelica
		Libro libroEncontrado2 = miBiblioteca.buscarLibro("123-3214567890");

		if (libroEncontrado2 == null)
			System.out.println("Error: Libro no encontrado");
		else {
			Prestamo prestamo2 = new Prestamo(2, estudiante2, libroEncontrado2);
			miBiblioteca.realizarPrestamo(prestamo2);
		}

		System.out.println("\n=== Libros disponibles ===");
		miBiblioteca.mostrarLibros();
	}
}
