public class Libro {
    private String titulo;
    private String autor;
    private String isbn;
    private boolean estado;
 
    public Libro(String titulo, String autor, String isbn) {
        this.titulo = titulo;
        this.autor = autor;
        this.isbn = isbn;
        this.estado = true;
    }
 
    @Override
    public String toString() {
        return "Libro{titulo='" + titulo + "', autor='" + autor + "', isbn='" + isbn + "', estado=" + estado + "}";
    }
}
 
